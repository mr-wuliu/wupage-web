# Keep the real RSA PEM outside this repository. Used only by setup-payments.ts.
WAFFO_PRIVATE_KEY_FILE=/absolute/path/outside/repo/private.pem
# Optional: reuse already approved production one-time products.
WAFFO_PRODUCT_5=
WAFFO_PRODUCT_15=
# For new products: the owner identifies the actual product as the browser extension.
WAFFO_TAX_CATEGORY=software
