{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wupage-web",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "html_handling": "auto-trailing-slash"
  },
  "vars": {
    "WAFFO_PRODUCT_5": "PROD_0sZHIaTbTzkihAxXiKIgSJ",
    "WAFFO_PRODUCT_15": "PROD_06AdGyMu98lhn4E3cZRKZi"
  },
  "routes": [
    {
      "pattern": "wupage.mrwuliu.top",
      "custom_domain": true,
      "zone_name": "mrwuliu.top"
    }
  ],
  "build": {
    "command": "npm run build",
    "watch_dir": [
      "assets",
      "index.html",
      "api.html",
      "guide.html",
      "privacy.html",
      "terms.html",
      "thanks.html",
      "_headers"
    ]
  }
}
